// fe1port.exe: the icon (resource 1: Explorer, shortcuts, the taskbar and SDL's window class take the exe's
// first icon) and the version information. tools/build.py compiles this with windres (cwd icons/) and links it.
#include <winver.h>

1 ICON "fe1.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "Fear Effect port"
            VALUE "FileDescription", "Fear Effect port"
            VALUE "Comments", "Native port of Fear Effect, recompiled from the player's own disc"
            VALUE "InternalName", "fe1port"
            VALUE "OriginalFilename", "fe1port.exe"
            VALUE "FileVersion", "1.0"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
