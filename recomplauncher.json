            "img",
            "iso"
          ]
        }
      ]
    },
    {
      "id": "fe2d2",
      "role": "disc",
      "label": "Fear Effect 2: Retro Helix, disc 2 of 4, USA v1.1, serial SLUS-01275. Pick the .cue, or the raw .bin or .img (2352-byte sectors). A 2048-byte .iso has no CD audio and is refused.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "cue",
            "bin",
            "img",
            "iso"
          ]
        }
      ]
    },
    {
      "id": "fe2d3",
      "role": "disc",
      "label": "Fear Effect 2: Retro Helix, disc 3 of 4, USA v1.1, serial SLUS-01276. Pick the .cue, or the raw .bin or .img (2352-byte sectors). A 2048-byte .iso has no CD audio and is refused.",
      "formats": [
        {
