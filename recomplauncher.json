{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Fear Effect",
  "repo": "iva1nn/project-helix",
  "inputs": [
    {
      "id": "fe1d1",
      "role": "disc",
      "label": "Fear Effect, disc 1 of 4, USA, serial SLUS-00920. Pick the .cue, or the raw .bin or .img (2352-byte sectors). A 2048-byte .iso has no CD audio and is refused.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "cue",
            "bin",
            "img",
            "iso"
          ]
        }
      ]
    },
    {
      "id": "fe1d2",
      "role": "disc",
      "label": "Fear Effect, disc 2 of 4, USA, serial SLUS-01056. Pick the .cue, or the raw .bin or .img (2352-byte sectors). A 2048-byte .iso has no CD audio and is refused.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "cue",
            "bin",
            "img",
            "iso"
          ]
        }
      ]
    },
    {
      "id": "fe1d3",
      "role": "disc",
      "label": "Fear Effect, disc 3 of 4, USA, serial SLUS-01057. Pick the .cue, or the raw .bin or .img (2352-byte sectors). A 2048-byte .iso has no CD audio and is refused.",
