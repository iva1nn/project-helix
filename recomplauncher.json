  "looks": {
    "graphics": "opengl",
    "lines": 240
  },
  "folders": {
    "fe1_saves": [
      {
        "path": "{install}/Fear Effect"
      }
    ],
    "fe2_saves": [
      {
        "path": "{install}/Fear Effect 2"
      }
    ],
    "logs": [
      {
        "path": "{install}"
      }
    ],
    "saves": [
      {
        "path": "{install}/Fear Effect",
        "if": "{install}/Fear Effect"
      },
      {
        "path": "{install}/Fear Effect 2",
        "if": "{install}/Fear Effect 2"
      },
      {
        "path": "{install}"
      }
    ]
  },
  "saves": [
    "{install}/Fear Effect/memcards",
    "{install}/Fear Effect/states",
    "{install}/Fear Effect/fe1port.ini",
    "{install}/Fear Effect 2/memcards",
    "{install}/Fear Effect 2/states",
    "{install}/Fear Effect 2/fe2port.ini"
  ],
  "actions": [
    {
      "id": "open_fe1",
      "label": "Open the Fear Effect folder",
      "open": "fe1_saves",
      "help": "The game, its memory card and its save states."
    },
    {
      "id": "open_fe2",
      "label": "Open the Fear Effect 2 folder",
      "open": "fe2_saves",
      "help": "The game, its memory card and its save states."
    },
    {
      "id": "open_log",
      "label": "Open the install folder",
      "open": "logs",
      "help": "install.log is in this folder."
    }
  ],
  "exit_codes": {
    "3": "This game has not been built yet. Set it up with all four discs and the asset pack.",
    "1": "The game could not start. Often a disc image could not be opened."
  }
}
