    {
      "id": "fe1d4",
      "role": "disc",
      "label": "Fear Effect, disc 4 of 4, USA, serial SLUS-01058. Pick the .cue, or the raw .bin or .img (2352-byte sectors). A 2048-byte .iso has no CD audio and is refused.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "cue",
            "bin",
            "img",
            "iso"
          ]
        }
      ]
    },
    {
      "id": "fe1assets",
      "role": "dlc",
      "label": "The extracted Fear Effect remaster pack. Pick the folder that contains fe1 and manifests (in the downloaded archive, that is the data folder). Extract the .7z first. If the pack is already inside this install, pick that data folder.",
      "formats": [
        {
          "type": "folder"
        }
      ]
    },
    {
      "id": "fe2d1",
      "role": "disc",
      "label": "Fear Effect 2: Retro Helix, disc 1 of 4, USA v1.1, serial SLUS-01266. Pick the .cue, or the raw .bin or .img (2352-byte sectors). A 2048-byte .iso has no CD audio and is refused.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "cue",
